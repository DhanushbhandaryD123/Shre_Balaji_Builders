# Sanity Project Configuration for Web Frontend
VITE_SANITY_PROJECT_ID=your_project_id_here
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Server-Side Only Token for /api/enquiry (NEVER expose to Vite client bundle!)
SANITY_WRITE_TOKEN=your_sanity_server_write_token_here

# Optional Email SMTP notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=enquiry@balajibentota.com
SMTP_PASS=your_secure_password
